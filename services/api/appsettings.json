{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=storage/sistemas-precios.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Storage": {
    "RootPath": "storage"
  },
  "Matching": {
    "AutoApproveThreshold": 0.91,
    "ReviewThreshold": 0.76
  },
  "Vision": {
    "GrpcUrl": "http://localhost:50051"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
