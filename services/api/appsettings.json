{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=storage/precios-v2.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Storage": {
    "RootPath": "storage"
  },
  "Matching": {
    "AutoApproveThreshold": 0.91,
    "ReviewThreshold": 0.76
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Extraction": {
    "Provider": "Gemini"
  },
  "Gemini": {
    "Model": "gemini-3.1-flash-lite"
  },
  "OpenAI": {
    "Model": "gpt-5.4-mini"
  }
}
